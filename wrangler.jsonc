{
  "name": "pullit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "pullit.fun", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "9ad40522615340b28c1df817106dc1c4" }],
  "limits": { "cpu_ms": 30000 },
  "durable_objects": { "bindings": [{ "name": "LOCK", "class_name": "TickLock" }] },
  "migrations": [{ "tag": "v1-lock", "new_sqlite_classes": ["TickLock"] }],
  "vars": {
    "TEAM_WALLET": "BQF2WHxY7ZmWdBPMatYdQZ9UygJuCtRmmRrkQQg3qD59",
    "MINT": "5Uycj5BUozB87WgocSPhFzGDvoUftvANadiWS4cKWLgG",
    "REPO_URL": "https://github.com/syanovee/pullit",
    "PUBLIC": "1",
    "DRY_RUN": "",
    "SPAWN": "",
  },
}
